# Development-only credentials. Change these before using this pattern outside a local POC.
NEXUS_BASE_URL=http://localhost:8081
NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_PASSWORD=local-demo-only-password

# Production-like policy used by the promoter when no override is supplied.
QUARANTINE_PERIOD=7d

# Short interval used by scripts/Run-Demo.ps1.
DEMO_QUARANTINE_PERIOD=45s
